---
import BaseHead from '../components/BaseHead.astro';
import { ConfiguredHeader } from '../components/Header/Header';
import { ConfiguredFooter } from '../components/Footer/Footer';
import SearchWidget from '../components/SearchWidget/SearchWidget';
import { SITE_TITLE, SITE_DESCRIPTION, BASE_URL, ELECTRONIC_CATALOG_URL, ELECTRONIC_CATALOG_TEXT, SEARCH_DOWN_CTA_URL, SEARCH_DOWN_CTA_TEXT, CONTACT_INFO } from '../config';
import { TbExternalLink } from 'react-icons/tb';

const pageTitle = "Library Catalog";
const fullTitle = `${pageTitle} | ${SITE_TITLE}`;

// External "browse the full catalog" shortcuts: the physical catalogue (OPAC)
// and the digital collection (CloudLibrary). Rendered only when configured.
const externalCatalogs = [
  { url: SEARCH_DOWN_CTA_URL, text: SEARCH_DOWN_CTA_TEXT },
  { url: ELECTRONIC_CATALOG_URL, text: ELECTRONIC_CATALOG_TEXT },
].filter((catalog) => Boolean(catalog.url) && Boolean(catalog.text));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-[var(--color-paper)] text-[var(--color-charcoal)] flex flex-col min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-forest)] focus:text-white focus:rounded focus:outline-none"
    >
      Skip to main content
    </a>
    <ConfiguredHeader client:load />

    <main id="main-content" class="flex-grow max-w-4xl mx-auto w-full px-4 py-12">
      <h1 class="type-heading-lg text-[var(--color-charcoal)] mb-6">{pageTitle}</h1>

      <p class="type-body text-[var(--color-charcoal)]/80 mb-2">
        Search our shelves and our digital collection in one place. Results show whether a title
        is available to borrow in print or instantly online.
      </p>
      {externalCatalogs.length > 0 && (
        <p class="type-body-sm text-[var(--color-charcoal)]/60 mb-6 flex flex-wrap items-center gap-x-2 gap-y-1">
          <span>Prefer to browse the full catalogs?</span>
          {externalCatalogs.map((catalog, index) => (
            <span class="inline-flex items-center gap-2">
              {index > 0 && (
                <span aria-hidden="true" class="hidden sm:inline text-[var(--color-stone)]">
                  &bull;
                </span>
              )}
              <a
                href={catalog.url}
                class="text-[var(--color-terracotta)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-forest)] inline-flex items-center gap-1"
                target="_blank"
                rel="noopener noreferrer"
              >
                {catalog.text}
                <TbExternalLink aria-hidden="true" className="inline-block" />
              </a>
            </span>
          ))}
        </p>
      )}
      <SearchWidget client:load showResultsInline={true} />
    </main>

    <ConfiguredFooter contactInfo={CONTACT_INFO} />
  </body>
</html>
